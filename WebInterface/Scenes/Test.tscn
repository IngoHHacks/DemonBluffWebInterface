script/source = "extends Node

func _ready():
    var tests_ok = true
    var test_arr = [1, 2, 2, 3]
    var perms = ArrayUtils.permutations(test_arr, 3)
    var combs = ArrayUtils.combinations(test_arr, 3)
    var perms_rep = ArrayUtils.permutations_with_repetition(test_arr, 3)
    var unique = ArrayUtils.unique(test_arr)
    if perms.size() != 12:
        tests_ok = false
        print(\"Permutations test failed: expected 12, got \", perms.size())
    if combs.size() != 3:
        tests_ok = false
        print(\"Combinations test failed: expected 3, got \", combs.size())
    if perms_rep.size() != 27:
        tests_ok = false
        print(\"Permutations with repetition test failed: expected 27, got \", perms_rep.size())
    if unique.size() != 3:
        tests_ok = false
        print(\"Unique test failed: expected 3, got \", unique.size())
    print(\"Tests done!\")
"

